{
  "manifest_version": 3,
  "name": "ZsFocus · 番茄专注",
  "version": "1.0.0",
  "description": "自定义用途的番茄时钟，配沉浸氛围音与专注统计报告。数据全部保存在本地。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "action": {
    "default_title": "ZsFocus 番茄专注",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "dashboard.html",
  "offline_enabled": true
}
